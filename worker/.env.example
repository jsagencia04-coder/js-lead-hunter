# ---- Obrigatório ----
# Supabase: Project Settings → Database → Connection string → "Session pooler" (porta 5432)
# ou conexão direta. NÃO use o "Transaction pooler" (6543).
# Esta credencial é de administrador do banco: fica SOMENTE no servidor do worker.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ---- Fonte oficial (Receita Federal, WebDAV público) ----
RF_MODE=webdav
RF_BASE_URL=https://arquivos.receitafederal.gov.br/public.php/webdav
RF_SHARE_TOKEN=YggdBLfdninEJX9
# Alternativa se a Receita bloquear/ficar fora do ar: baixe os ZIPs manualmente
# numa pasta AAAA-MM/ e use RF_MODE=local + RF_LOCAL_DIR apontando para a pasta-mãe
# RF_LOCAL_DIR=C:\Users\voce\Downloads\cnpj      (Windows)   ou   /data/manual   (Docker)

# Pasta de trabalho (ZIPs e temporários, ~40 GB). Vazio = pasta "data" ao lado do worker.
# DATA_DIR=

# ---- Regras de prospecção ----
LEAD_WINDOW_DAYS=15        # plano gratuito do Supabase: 15; plano Pro: 90. Só empresas abertas nos últimos N dias entram na base operacional
INCLUDE_BRANCHES=false     # true = filiais também viram leads

# ---- Operação ----
CHECK_INTERVAL_HOURS=12    # verificação automática de nova competência
AUTO_IMPORT=true           # importar sozinho quando houver competência nova
POLL_SECONDS=30            # intervalo para atender pedidos feitos na interface
DOWNLOAD_CONNECTIONS=8     # a Receita limita IPs agressivos; não passe de 16
DOWNLOAD_CHUNK_MB=8
KEEP_LOCAL_ZIPS=false
DUCKDB_MEMORY=2GB
DUCKDB_THREADS=4

# ---- Armazenamento temporário opcional (Cloudflare R2 ou S3) ----
# S3_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_BUCKET=js-lead-hunter
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# ---- Inteligência digital (processo separado: python -m lead_hunter intel) ----
# Provedores pagos são opcionais; sem chave, o canal fica "pendente" (nunca "não localizado").
# GOOGLE_PLACES_API_KEY=      # Google Places API (New): Perfil da Empresa no Google
# BRAVE_SEARCH_API_KEY=       # Brave Search API: site, Instagram, Facebook e LinkedIn
# INTEL_IN_WORKER=false       # true = o "run" também processa a fila (VPS com um único processo)
# INTEL_MINUTES=10
# DB_SIZE_LIMIT_MB=500        # trava de espaço (plano gratuito do Supabase); Pro: 8000
